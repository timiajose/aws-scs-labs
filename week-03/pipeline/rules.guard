#
# Policy-as-code gates for IAM resources in CloudFormation templates.
#
let iam_roles = Resources.*[ Type == 'AWS::IAM::Role' ]

#
# Rule 1: every IAM role must carry a permissions boundary.
#
rule roles_must_have_a_permissions_boundary when %iam_roles !empty {
  %iam_roles.Properties.PermissionsBoundary exists
  <<
    VIOLATION: every AWS::IAM::Role must set PermissionsBoundary.
    Without it, a created role can exceed its creator's own permissions.
  >>
}

#
# Rule 2: a trust policy must not allow any AWS principal.
# Principal is a map - {"Service": ...} or {"AWS": ...} - so we check the AWS key
# only, and only when it is present. A Service principal is fine.
#
rule no_wildcard_aws_principal_in_trust_policy when %iam_roles !empty {
  %iam_roles.Properties.AssumeRolePolicyDocument.Statement[*] {
    when Principal.AWS exists {
      Principal.AWS != "*"
      <<
        VIOLATION: trust policy uses Principal.AWS "*" - ANY AWS principal
        in ANY account could assume this role.
      >>
    }
  }
}

#
# Rule 3: iam:PassRole must never be granted on Resource "*".
#
rule no_passrole_on_star when %iam_roles !empty {
  %iam_roles.Properties.Policies[*].PolicyDocument.Statement[*] {
    when Action == "iam:PassRole" {
      Resource != "*"
      <<
        VIOLATION: iam:PassRole on Resource "*" allows passing ANY role to ANY
        service - a privilege escalation path. Scope to specific role ARNs and
        add the iam:PassedToService condition.
      >>
    }
  }
}

#
# Rule 4: secrets must never be plaintext in Lambda environment variables.
#
# Note on method: this rule ENUMERATES common secret-ish variable names, which is
# the weaker approach we generally avoid. It is here because cfn-guard cannot
# pattern-match on key names. The real control is structural - the function fetches
# from Secrets Manager at runtime using its execution role, or the template uses a
# dynamic reference '{{resolve:secretsmanager:...}}' which CloudFormation resolves
# at deploy time and never stores.
#
# Secret scanners will NOT catch this: a placeholder like "ChangeMe123!" is
# low-entropy and looks deliberate. The structure is the finding, not the value.
#
let lambdas = Resources.*[ Type == 'AWS::Lambda::Function' ]

rule no_plaintext_secrets_in_lambda_env when %lambdas !empty {
  %lambdas.Properties.Environment.Variables.DB_PASSWORD not exists
  %lambdas.Properties.Environment.Variables.PASSWORD not exists
  %lambdas.Properties.Environment.Variables.SECRET not exists
  %lambdas.Properties.Environment.Variables.API_KEY not exists
  %lambdas.Properties.Environment.Variables.PRIVATE_KEY not exists
  %lambdas.Properties.Environment.Variables.AWS_SECRET_ACCESS_KEY not exists
  <<
    VIOLATION: a secret-named environment variable is set on a Lambda function.
    Environment variables are visible via lambda:GetFunctionConfiguration, in the
    console, and in CloudFormation stack events. Use a Secrets Manager dynamic
    reference, or fetch at runtime with the execution role.
  >>
}
